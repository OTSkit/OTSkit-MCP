{
  "name": "@otskit/mcp",
  "version": "0.1.5",
  "description": "OpenTimestamps MCP server — stamp, upgrade, verify via AI agents",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ots-mcp": "dist/index.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@otskit/core": "^0.1.0",
