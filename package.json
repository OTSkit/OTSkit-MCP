{
  "name": "@otskit/mcp",
  "mcpName": "io.github.AlexAlves87/otskit-mcp",
  "version": "0.10.1",
  "license": "MIT",
  "description": "OpenTimestamps MCP server — stamp, upgrade, verify via AI agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/OTSkit/OTSkit-MCP.git"
  },
  "homepage": "https://github.com/OTSkit/OTSkit-MCP#readme",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "otskit",
    "opentimestamps",
    "bitcoin",
    "typescript",
    "timestamping",
    "mcp",
    "mcp-server",
    "ai-agents"
  ],
  "bin": {
    "ots-mcp": "dist/index.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --external node-sqlite3-wasm",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@otskit/client": "^0.7.2",
    "node-sqlite3-wasm": "0.8.61",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "hono": "4.13.13",
      "undici@^6.0.0": "6.29.0",
      "undici@^7.0.0": "7.30.0",
      "postcss": "8.5.30"
    }
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.9",
    "semantic-release": "^25.0.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.9"
  }
}
