{
  "name": "@otskit/mcp",
  "mcpName": "io.github.AlexAlves87/otskit-mcp",
  "version": "0.6.2",
  "license": "MIT",
  "description": "OpenTimestamps MCP server — stamp, upgrade, verify via AI agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/OTSkit/OTSkit-MCP.git"
  },
  "homepage": "https://github.com/OTSkit/OTSkit-MCP#readme",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ots-mcp": "dist/index.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --external node-sqlite3-wasm",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@otskit/client": "^0.2.0",
    "@otskit/core": "^0.1.0",
    "node-sqlite3-wasm": "0.8.57"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/node": "^25.9.1",
    "semantic-release": "^25.0.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^2.1.4"
  }
}
